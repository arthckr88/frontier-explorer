{
  "name": "frontier-route-explorer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "tsx src/site/check-integrity.ts && node scripts/build-pages.mjs",
    "normalize:network": "tsx src/site/normalize-network.ts",
    "check:integrity": "tsx src/site/check-integrity.ts",
    "update:published": "tsx src/site/update-published.ts",
    "frontier:browser": "tsx src/site/browser/cli.ts",
    "frontier:browser:queue": "tsx src/site/browser/cli.ts --queue",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:setup": "tsx src/server/db/migrate.ts && tsx src/server/db/seed.ts",
    "sync": "tsx src/server/jobs/cli.ts all",
    "sync:priority": "tsx src/server/jobs/cli.ts priority",
    "sync:schedules": "tsx src/server/jobs/cli.ts schedules",
    "sync:announcements": "tsx src/server/jobs/cli.ts announcements",
    "sync:programs": "tsx src/server/jobs/cli.ts programs",
    "reconcile": "tsx src/server/jobs/cli.ts reconcile"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "luxon": "^3.7.2",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
