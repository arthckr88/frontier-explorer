# PostgreSQL. Docker Compose defaults match these values.
DATABASE_URL=postgresql://frontier:frontier@localhost:5432/frontier

# Required to call /api/cron. Leave unset locally and the endpoint stays closed.
CRON_SECRET=

# Required for /admin sync triggers and other dev actions. Leave unset to keep them closed.
ADMIN_SECRET=

# MapLibre style JSON. The default is OpenFreeMap's dark style and needs no API key.
TILE_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Optional tier-3 timetable. The app boots and syncs without these.
TIMETABLE_API_URL=
TIMETABLE_API_KEY=

# Optional override for the public BTS international segment resource.
BTS_INTERNATIONAL_RESOURCE_URL=https://data.transportation.gov/resource/xgub-n9bw.json
# Optional domestic T-100 segment resource. Leave empty if you do not have a public endpoint.
BTS_DOMESTIC_RESOURCE_URL=

# Comma-separated public airport press-release or RSS URLs. Empty is fine.
AIRPORT_PRESS_URLS=

# FlightAware AeroAPI. Server and build-time only. Never put the key in client JS, git, or Pages output.
# There is no key in this example. Live import waits until FLIGHTAWARE_API_KEY is set.
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_MAX_RUN_COST_USD=4.00
FLIGHTAWARE_MAX_PAGES=2
SCHEDULE_NEAR_DAYS=14
SCHEDULE_PLANNING_DAYS=60
SCHEDULE_EXTENDED_DAYS=180

# Public booking search. The Pages verifier checks only the priority corridors, at most 20 dates a run.
PUBLIC_SCHEDULE_DAYS=7
PUBLIC_SCHEDULE_CONCURRENCY=4
# Optional comma-separated subset of the priority origins. Empty searches all ten.
PUBLIC_SCHEDULE_ORIGINS=

# Sync intervals. The hourly cron calls /api/cron, which runs a job only when it is due.
SYNC_PRIORITY_HOURS=2
SYNC_SCHEDULE_HOURS=6
SYNC_ANNOUNCEMENTS_HOURS=2
SYNC_PROGRAMS_HOURS=24
SYNC_RECONCILE_HOURS=24
SYNC_POPULARITY_DAYS=30

# Reconciliation thresholds.
ENDING_SOON_DAYS=21
POSSIBLY_ENDING_GAP_DAYS=21
SPARSE_LOOKAHEAD_DAYS=21
STALE_VERIFICATION_HOURS=48
SEASONAL_GAP_DAYS=60
